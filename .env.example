# CareLink Backend — Environment Variables
# Copy this file to .env and fill in real values

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://neondb_owner:YOURPASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# JWT secret — use a long random string in production
JWT_SECRET=carelink-super-secret-jwt-key-change-this-in-production

# Server port
PORT=3000

# Backend public URL (used to construct photo URLs)
# In development: http://localhost:3000
# In production (Render.com): https://your-app.onrender.com
BACKEND_URL=http://localhost:3000

# Node environment
NODE_ENV=development
